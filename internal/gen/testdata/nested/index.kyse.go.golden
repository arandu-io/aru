//go:build kyse

package purchaseorders

import (
	"fmt"

	"github.com/arandu-io/hesape/pagination"
	"github.com/arandu-io/hesape/view"
	"github.com/arandu-io/kyse/components"
)

@go
// PurchaseOrdersIndexData is what PurchaseOrderController.Index hands this page.
type PurchaseOrdersIndexData struct {
	// view.Page is the chrome the layout draws: the title, the description, the
	// CSRF token and the navigation. Embedded rather than repeated, and what
	// makes this struct fit the layout.
	view.Page
	// PurchaseOrders is the page of records.
	PurchaseOrders []PurchaseOrderRow
	// Result is what the service's List returned beside the rows: the listing
	// state that was read, the page with its total, and the count of every facet
	// value. The table is drawn from it and nothing else about the listing is
	// copied out, so the pager, the search box and the sort arrows can never
	// disagree about what is on screen.
	Result *pagination.ListingResult
	// ListURL is the address of the listing itself, which every control of the
	// table is built on. It is addressed by route name in the controller rather
	// than written here as a path.
	ListURL string
	// NewURL is where the "new" button goes: the create screen, addressed by
	// route name in the controller rather than written here as a path. A view
	// has no route table, so a link written here could only be a literal -- and
	// a literal keeps rendering after the route moves.
	NewURL string
}

// Compile-time proof that this page fits the layout it extends.
var _ view.Layout = PurchaseOrdersIndexData{}

// PurchaseOrdersTableID is the id of the element the table is drawn into. A control
// of the table names it as the htmx target, and PurchaseOrderController.Index reads it
// from HX-Target to answer the table alone instead of the whole page.
const PurchaseOrdersTableID = "purchase-orders-table"

// PurchaseOrderRow is one record, formatted by the controller: what the listing
// and the record show, and what the edit form starts at.
type PurchaseOrderRow struct {
	// ID is what the row is addressed by.
	ID string
	// URL is where the row links to, built from the route name by the
	// controller.
	URL string
	// Reference is the Reference column.
	Reference string
	// SupplierEmail is the Supplier email column.
	SupplierEmail string
	// Total is the Total column.
	Total string
	// Approved is the Approved column.
	Approved bool
	// Notes is the Notes column.
	Notes string
	// DeliveryDate is the Delivery date column.
	DeliveryDate string
	// Created is the creation timestamp, already formatted.
	Created string
}

// PurchaseOrderIndexTable adapts the page the service listed to the Kyse DataTable.
//
// The state of the listing -- the search, the order, the page and its size, the
// hidden columns -- is the result's, and every address the table draws is built
// from it. What is written here is only the columns and how a row becomes cells.
// A column's Key is the public key the listing declares in the service, for the
// sort and for hiding: a key the listing does not declare changes nothing.
func PurchaseOrderIndexTable(data PurchaseOrdersIndexData) components.DataTableProps {
	rows := make([]components.TableRow, 0, len(data.PurchaseOrders))
	for _, purchaseOrder := range data.PurchaseOrders {
		rows = append(rows, components.TableRow{
			Key: purchaseOrder.ID,
			Cells: []components.TableCell{
				{HTML: components.Link(components.LinkProps{
					Label: fmt.Sprint(purchaseOrder.Reference),
					URL: purchaseOrder.URL,
					Variant: "hover",
				})},
				{Text: fmt.Sprint(purchaseOrder.SupplierEmail)},
				{Text: fmt.Sprint(purchaseOrder.Total)},
				{Text: fmt.Sprint(purchaseOrder.Approved)},
				{Text: fmt.Sprint(purchaseOrder.Notes)},
				{Text: fmt.Sprint(purchaseOrder.DeliveryDate)},
				{Text: purchaseOrder.Created},
			},
		})
	}
	return components.DataTableProps{
		ID: PurchaseOrdersTableID,
		Label: data.Title,
		URL: data.ListURL,
		Result: data.Result,
		PageData: data.Page,
		Searchable: true,
		HeaderMenu: true,
		FullPager: true,
		SelectName: "ids",
		Columns: []components.TableColumn{
			{Label: "Reference", Key: "reference", Sortable: true},
			{Label: "Supplier email", Key: "supplier_email", Sortable: true, Hideable: true},
			{Label: "Total", Key: "total", Sortable: true, Hideable: true},
			{Label: "Approved", Key: "approved", Sortable: true, Hideable: true},
			{Label: "Notes", Key: "notes", Sortable: true, Hideable: true},
			{Label: "Delivery date", Key: "delivery_date", Sortable: true, Hideable: true},
			{Label: "Created", Key: "created_at", Sortable: true, Hideable: true},
		},
		Rows: rows,
		Empty: components.EmptyProps{
			Title: "No purchase order yet.",
			Message: "Add the first purchase order to get started.",
			ActionLabel: "New purchase order",
			ActionURL: data.NewURL,
		},
	}
}

// arandu:begin custom
// Anything else these pages need in Go goes here, and survives regeneration.
// arandu:end custom
@endgo

@extends('layouts.app')

@section('content')
	<div class="flex items-center justify-between gap-4">
		<h1 class="text-3xl font-semibold tracking-tight">{{ .Title }}</h1>
		<a class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900" href="{{ .NewURL }}">New purchase order</a>
	</div>

	{{-- The table is a file of its own, because it is the one part of this page
	     the server also answers alone: a search, a sort, a facet, a page step or
	     a column switch replaces it and nothing else. @include hands this page's
	     data over unchanged. The pager is the table's own; there is no second
	     one beside it. --}}
	<div class="mt-8">
		@include('partials.purchase-orders-table')
	</div>
@endsection
