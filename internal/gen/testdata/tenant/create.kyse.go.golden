	<nav class="text-sm text-slate-500 dark:text-slate-400">
		<a class="underline underline-offset-2 hover:text-slate-900 dark:hover:text-slate-100" href="{{ .IndexURL }}">Purchase orders</a>
	</nav>

	<h1 class="mt-2 text-3xl font-semibold tracking-tight">{{ .Title }}</h1>

	<form class="mt-8 space-y-6" method="post" action="{{ .StoreURL }}" hx-post="{{ .StoreURL }}" hx-target="this" hx-swap="outerHTML">
		@csrf
		
		{!! components.Field(components.FieldProps{
			Name:  "reference",
			Label: "Reference",
			Type:  "text",
			Value: .Form.Reference,
			Page: .,
			Required: true,
		}) !!}

		{!! components.Field(components.FieldProps{
			Name:  "supplier_email",
			Label: "Supplier email",
			Type:  "email",
			Value: .Form.SupplierEmail,
			Page: .,
			Required: true,
		}) !!}

		{!! components.Field(components.FieldProps{
			Name:  "total",
			Label: "Total",
			Type:  "number",
			Value: .Form.Total,
			Page: .,
			Required: true,
		}) !!}

		<label class="flex items-center gap-2 text-sm">
			<input class="input" id="approved" name="approved" type="checkbox" value="1" {{ .Form.ApprovedAttr() }}>
			Approved
		</label>

		{!! components.Textarea(components.TextareaProps{
			Name:  "notes",
			Label: "Notes",
			Value: .Form.Notes,
			Page: .,
			Rows:  6,
		}) !!}

		{!! components.Field(components.FieldProps{
			Name:  "delivery_date",
			Label: "Delivery date",
			Type:  "date",
			Value: .Form.DeliveryDate,
			Page: .,
		}) !!}

		<div class="flex items-center gap-3">
			<button class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300" type="submit">Save</button>
			<a class="text-sm text-slate-500 underline underline-offset-2 dark:text-slate-400" href="{{ .IndexURL }}">Cancel</a>
		</div>
	</form>
