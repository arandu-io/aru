# Copied into .env by everybody who checks this project out, so every value here
# is the one the first boot runs with.

# --- config/database.go ----------------------------------------------------
# A server, and the project links no connector for it: nothing imports
# github.com/arandu-io/hesape/database/connectors/pgx.
DATABASE_URL=postgres://app:secret@127.0.0.1:5432/app

# --- config/session.go -----------------------------------------------------
SESSION_DRIVER=memory

# --- config/cache.go -------------------------------------------------------
# The shared store, and nothing imports github.com/arandu-io/hesape/redis.
CACHE_STORE=redis

# --- config/queue.go -------------------------------------------------------
# Linked into a test binary and into nothing else: the only import is in
# tests/Feature/queue_test.go, and a test is not compiled into what boots.
QUEUE_CONNECTION=redis
