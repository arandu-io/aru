package purchaseorder

import (
	"context"
	"crypto/rand"
	"database/sql"
	"errors"
	"fmt"
	"strconv"
	"strings"
	"time"

	"github.com/arandu-io/framework/data"
	"github.com/arandu-io/framework/security"
)

// Errors this repository returns, so callers never import database/sql.
var (
	ErrNotFound = errors.New("purchase_order: not found")
	ErrConflict = errors.New("purchase_order: already exists")
	ErrSort     = errors.New("purchase_order: sort field not allowed")
)

// Pagination bounds. A request that asks for everything gets the maximum, never
// everything: an unbounded query is how one page load takes a database down.
const (
	defaultLimit = 50
	maxLimit     = 200
)

// Repo is the only door to the purchase_orders table.
//
// Every method starts with g.Check. The Grant is required by the signature, so
// forgetting it is a compile error, and the check proves the grant was issued for
// this exact action -- which catches copy-paste between methods.
//
// The SQL uses "?" placeholders and types every supported database shares, so
// these statements run unchanged on SQLite and PostgreSQL.
type Repo struct {
	db *data.DB
}

// NewRepo returns a repository over an instrumented handle.
func NewRepo(db *data.DB) *Repo { return &Repo{db: db} }

// Compile-time proof of the contract.
var _ data.Repository[PurchaseOrder, string] = (*Repo)(nil)

const columns = `id, reference, supplier_email, total, approved, notes, delivery_date, created_at`

// Find returns one purchase_order by id.
func (r *Repo) Find(ctx context.Context, g security.Grant, id string) (PurchaseOrder, error) {
	if err := g.Check(ActionView); err != nil {
		return PurchaseOrder{}, err
	}
	row := r.db.QueryRowContext(ctx,
		`SELECT `+columns+` FROM purchase_orders WHERE id = ?`, id)
	return scan(row)
}

// sortable is the ordering allowlist. A sort field is a column name, and a column
// name taken from the request is injection through a door nobody watches.
var sortable = map[string]string{
	"":               "created_at",
	"created_at":     "created_at",
	"reference":      "reference",
	"supplier_email": "supplier_email",
	"notes":          "notes",
	"delivery_date":  "delivery_date",
}

// List returns a page of purchase_orders.
//
// Pagination is keyset based: OFFSET grows more expensive with every page and
// skips rows when data changes underneath it.
func (r *Repo) List(ctx context.Context, g security.Grant, q data.Query) ([]PurchaseOrder, error) {
	// ActionList, not ActionView. The specification can grant them to different
	// roles -- "a support agent may open the record it was given, but may not
	// page through every record there is" -- and checking view here made the
	// list permission decorative: whoever could read one could read all of them.
	if err := g.Check(ActionList); err != nil {
		return nil, err
	}
	column, ok := sortable[q.Sort]
	if !ok {
		return nil, fmt.Errorf("%w: %q", ErrSort, q.Sort)
	}

	limit := q.Limit
	switch {
	case limit <= 0:
		limit = defaultLimit
	case limit > maxLimit:
		limit = maxLimit
	}

	query := `SELECT ` + columns + ` FROM purchase_orders WHERE 1 = 1`
	var args []any
	if q.Cursor != "" {
		// See the tenant branch: the predicate follows q.Sort, not created_at.
		query += ` AND (` + column + ` > (SELECT ` + column + ` FROM purchase_orders WHERE id = ?)
		            OR (` + column + ` = (SELECT ` + column + ` FROM purchase_orders WHERE id = ?) AND id > ?))`
		args = append(args, q.Cursor, q.Cursor, q.Cursor)
	}
	query += ` ORDER BY ` + column + `, id LIMIT ?`
	args = append(args, limit)
	_ = strconv.Itoa // kept for templates that build placeholder lists

	rows, err := r.db.QueryContext(ctx, query, args...)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	var out []PurchaseOrder
	for rows.Next() {
		p, err := scan(rows)
		if err != nil {
			return nil, err
		}
		out = append(out, p)
	}
	return out, rows.Err()
}

// Create inserts the purchase_order and returns it as stored.
func (r *Repo) Create(ctx context.Context, g security.Grant, p PurchaseOrder) (PurchaseOrder, error) {
	if err := g.Check(ActionCreate); err != nil {
		return PurchaseOrder{}, err
	}

	var err error
	if p.ID == "" {
		if p.ID, err = NewID(); err != nil {
			return PurchaseOrder{}, err
		}
	}
	p.SupplierEmail = normalize(p.SupplierEmail)
	p.CreatedAt = time.Now().UTC()

	_, err = r.db.ExecContext(ctx,
		`INSERT INTO purchase_orders (`+columns+`) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
		p.ID, p.Reference, p.SupplierEmail, p.Total, p.Approved, p.Notes, p.DeliveryDate, p.CreatedAt)
	if err != nil {
		if isConflict(err) {
			return PurchaseOrder{}, ErrConflict
		}
		return PurchaseOrder{}, err
	}
	return p, nil
}

// Update writes the mutable fields.
func (r *Repo) Update(ctx context.Context, g security.Grant, p PurchaseOrder) (PurchaseOrder, error) {
	if err := g.Check(ActionUpdate); err != nil {
		return PurchaseOrder{}, err
	}
	p.SupplierEmail = normalize(p.SupplierEmail)

	res, err := r.db.ExecContext(ctx,
		`UPDATE purchase_orders SET reference = ?, supplier_email = ?, total = ?, approved = ?, notes = ?, delivery_date = ? WHERE id = ?`,
		p.Reference, p.SupplierEmail, p.Total, p.Approved, p.Notes, p.DeliveryDate, p.ID)
	if err != nil {
		if isConflict(err) {
			return PurchaseOrder{}, ErrConflict
		}
		return PurchaseOrder{}, err
	}
	if n, err := res.RowsAffected(); err == nil && n == 0 {
		return PurchaseOrder{}, ErrNotFound
	}
	return p, nil
}

// Delete removes one purchase_order.
func (r *Repo) Delete(ctx context.Context, g security.Grant, id string) error {
	if err := g.Check(ActionDelete); err != nil {
		return err
	}
	res, err := r.db.ExecContext(ctx,
		`DELETE FROM purchase_orders WHERE id = ?`, id)
	if err != nil {
		return err
	}
	if n, err := res.RowsAffected(); err == nil && n == 0 {
		return ErrNotFound
	}
	return nil
}

type rowScanner interface{ Scan(dest ...any) error }

func scan(row rowScanner) (PurchaseOrder, error) {
	var p PurchaseOrder
	err := row.Scan(&p.ID, &p.Reference, &p.SupplierEmail, &p.Total, &p.Approved, &p.Notes, &p.DeliveryDate, &p.CreatedAt)
	if errors.Is(err, sql.ErrNoRows) {
		return PurchaseOrder{}, ErrNotFound
	}
	if err != nil {
		return PurchaseOrder{}, err
	}
	return p, nil
}

// normalize lowercases and trims, which is what keeps a plain UNIQUE index
// case-insensitive on every engine.
func normalize(s string) string { return strings.ToLower(strings.TrimSpace(s)) }

// NewID returns a version 4 UUID as text. Ids come from the application, not from
// a database default, so one schema works on every engine.
func NewID() (string, error) {
	var b [16]byte
	if _, err := rand.Read(b[:]); err != nil {
		return "", fmt.Errorf("purchase_order: reading random bytes: %w", err)
	}
	b[6] = (b[6] & 0x0f) | 0x40
	b[8] = (b[8] & 0x3f) | 0x80
	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16]), nil
}

// isConflict recognizes a duplicate key across engines by message, which is the
// price of not importing a driver into a module.
func isConflict(err error) bool {
	if err == nil {
		return false
	}
	msg := strings.ToLower(err.Error())
	return strings.Contains(msg, "unique constraint") ||
		strings.Contains(msg, "duplicate key") ||
		strings.Contains(msg, "duplicate entry")
}

// arandu:begin custom
// Queries beyond the five above go here, and survive regeneration. Keep the
// g.Check as the first line of each one.
// arandu:end custom
