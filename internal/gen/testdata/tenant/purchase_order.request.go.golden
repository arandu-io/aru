package purchaseorder

import (
	"time"

	"github.com/arandu-io/framework/validation"
)

// CreateRequest is the input contract. Fields are explicit: there is no mass
// assignment, so a field the client sends and this struct does not declare goes
// nowhere.
type CreateRequest struct {
	Reference     string
	SupplierEmail string
	Total         int64
	Approved      bool
	Notes         string
	DeliveryDate  time.Time
}

// Validate reports the errors per field.
func (r CreateRequest) Validate() validation.Errors {
	e := validation.Errors{}
	validation.Required(e, "reference", r.Reference)
	validation.MaxLen(e, "reference", r.Reference, 500)
	validation.Required(e, "supplier_email", r.SupplierEmail)
	validation.Email(e, "supplier_email", r.SupplierEmail)
	validation.MaxLen(e, "supplier_email", r.SupplierEmail, 254)
	validation.Required(e, "total", "")
	validation.MaxLen(e, "notes", r.Notes, 500)

	// arandu:begin custom
	// Domain rules go here: ranges, formats, cross-field checks.
	// arandu:end custom

	return e
}

// UpdateRequest carries the id as well, and the same rules.
type UpdateRequest struct {
	ID            string
	Reference     string
	SupplierEmail string
	Total         int64
	Approved      bool
	Notes         string
	DeliveryDate  time.Time
}

// Validate reports the errors per field.
func (r UpdateRequest) Validate() validation.Errors {
	e := CreateRequest{
		Reference:     r.Reference,
		SupplierEmail: r.SupplierEmail,
		Total:         r.Total,
		Approved:      r.Approved,
		Notes:         r.Notes,
		DeliveryDate:  r.DeliveryDate,
	}.Validate()
	validation.Required(e, "id", r.ID)
	return e
}

// Compile-time proof that both requests honor the validation contract.
var (
	_ validation.Validatable = CreateRequest{}
	_ validation.Validatable = UpdateRequest{}
)

var _ = time.Time{}
