# Each line below is a shape the loader reads and the driver rule has to read
# the same way, and none of them names an engine this project does not link.

# A comment is not a setting, at boot or here.
#CACHE_STORE=redis

# The `export` prefix and the quotes are both in the loader's format. MySQL is
# linked by the blank import in bootstrap/app.go.
export DATABASE_URL="mysql://app:secret@127.0.0.1:3306/app"

# Linked by a named import in bootstrap/sessions.go: the connector's init runs
# whatever name the import is given.
SESSION_DRIVER=redis

# Set twice. The loader keeps the first line, which needs nothing linked.
QUEUE_CONNECTION=database
QUEUE_CONNECTION=redis

CACHE_STORE=memory
