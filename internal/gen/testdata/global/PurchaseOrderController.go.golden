package controllers

import (
	"strconv"

	fhttp "github.com/arandu-io/framework/http"
	"github.com/arandu-io/framework/security"
	"github.com/arandu-io/hesape/pagination"
	"github.com/arandu-io/hesape/view"

	requests "example.test/project/app/Http/Requests"
	models "example.test/project/app/Models"
	services "example.test/project/app/Services"
	views "example.test/project/storage/framework/views/purchase-orders"
)

// PurchaseOrderController answers the seven routes of the purchase-orders resource.
//
// It is thin on purpose: read the request, call the service, render. There is no
// repository here and there cannot be one -- fhttp.Context carries no database
// handle, so a controller that reached the data layer would be a controller that
// skipped the service, and therefore skipped the policy.
//
// The routes sit behind middleware.RequireAuth, which puts who is asking on the
// request: ctx.User reads it. Without the guard there is nobody there, and the
// policy refuses the zero subject. An error an action returns is answered by the
// router -- validation.Errors back to the form with the messages and what was
// typed, a missing row as 404, a refusal as 403 -- so no action maps one itself.
type PurchaseOrderController struct {
	Controller

	svc      *services.PurchaseOrderService
	sessions *security.SessionStore
	csrf     *security.CSRF
}

// NewPurchaseOrderController returns the controller. bootstrap builds it and hands it to
// the routes.
//
// The session store and the CSRF issuer are here for one thing, the token every
// page carries: a screen is allowed to know about a token and a cookie, and a
// service is not.
func NewPurchaseOrderController(svc *services.PurchaseOrderService, sessions *security.SessionStore, csrf *security.CSRF) *PurchaseOrderController {
	return &PurchaseOrderController{svc: svc, sessions: sessions, csrf: csrf}
}

// Compile-time proof of the seven actions fhttp.Router.Resource looks for. It
// registers the ones the controller implements and nothing else, so a route that
// exists is a route that answers -- and a renamed method fails the build here
// rather than answering 404 in production.
var (
	_ fhttp.Indexer   = (*PurchaseOrderController)(nil)
	_ fhttp.Creator   = (*PurchaseOrderController)(nil)
	_ fhttp.Storer    = (*PurchaseOrderController)(nil)
	_ fhttp.Shower    = (*PurchaseOrderController)(nil)
	_ fhttp.Editor    = (*PurchaseOrderController)(nil)
	_ fhttp.Updater   = (*PurchaseOrderController)(nil)
	_ fhttp.Destroyer = (*PurchaseOrderController)(nil)
)

// Index renders the listing, one page at a time.
func (c *PurchaseOrderController) Index(ctx *fhttp.Context) error {
	who, _ := ctx.User()
	found, err := c.svc.List(ctx.Ctx(), who, pagination.ResolveCurrentPage(ctx.Request.URL, ""))
	if err != nil {
		return err
	}
	page, err := c.page(ctx, "Purchase orders")
	if err != nil {
		return err
	}

	rows := make([]views.PurchaseOrderRow, 0, found.Count())
	for _, p := range found.Items() {
		rows = append(rows, c.row(ctx, p))
	}
	return ctx.View("purchase-orders.index", views.PurchaseOrdersIndexData{
		Page:           page,
		PurchaseOrders: rows,
		NewURL:         ctx.URL("purchase-orders.create"),
		NextURL:        found.SetPath(ctx.URL("purchase-orders.index")).NextPageURL(),
	})
}

// Show renders one record.
func (c *PurchaseOrderController) Show(ctx *fhttp.Context) error {
	who, _ := ctx.User()
	found, err := c.svc.Get(ctx.Ctx(), who, ctx.Param("id"))
	if err != nil {
		return err
	}
	page, err := c.page(ctx, "Purchase order")
	if err != nil {
		return err
	}

	return ctx.View("purchase-orders.show", views.PurchaseOrdersShowData{
		Page:          page,
		PurchaseOrder: c.row(ctx, found),
		IndexURL:      ctx.URL("purchase-orders.index"),
		EditURL:       ctx.URL("purchase-orders.edit", found.ID),
		DeleteURL:     ctx.URL("purchase-orders.destroy", found.ID),
	})
}

// Create renders the empty form, or the rejected one: the page carries what
// was typed and the messages, from the flash the router left.
func (c *PurchaseOrderController) Create(ctx *fhttp.Context) error {
	page, err := c.page(ctx, "New purchase order")
	if err != nil {
		return err
	}

	return ctx.View("purchase-orders.create", views.PurchaseOrdersCreateData{
		Page:     page,
		IndexURL: ctx.URL("purchase-orders.index"),
		StoreURL: ctx.URL("purchase-orders.store"),
	})
}

// Store takes the submitted form.
func (c *PurchaseOrderController) Store(ctx *fhttp.Context) error {
	var in requests.PurchaseOrderRequest
	if err := ctx.Bind(&in); err != nil {
		return err
	}
	who, _ := ctx.User()
	created, err := c.svc.Create(ctx.Ctx(), who, in)
	if err != nil {
		return err
	}
	return ctx.RedirectRoute("purchase-orders.show", created.ID)
}

// Edit renders the form filled in with the stored record.
func (c *PurchaseOrderController) Edit(ctx *fhttp.Context) error {
	who, _ := ctx.User()
	found, err := c.svc.Get(ctx.Ctx(), who, ctx.Param("id"))
	if err != nil {
		return err
	}
	page, err := c.page(ctx, "Edit purchase order")
	if err != nil {
		return err
	}

	return ctx.View("purchase-orders.edit", views.PurchaseOrdersEditData{
		Page:      page,
		Form:      c.row(ctx, found),
		ShowURL:   ctx.URL("purchase-orders.show", found.ID),
		UpdateURL: ctx.URL("purchase-orders.update", found.ID),
	})
}

// Update writes the submitted form onto the stored record.
func (c *PurchaseOrderController) Update(ctx *fhttp.Context) error {
	var in requests.PurchaseOrderRequest
	if err := ctx.Bind(&in); err != nil {
		return err
	}
	who, _ := ctx.User()
	updated, err := c.svc.Update(ctx.Ctx(), who, ctx.Param("id"), in)
	if err != nil {
		return err
	}
	return ctx.RedirectRoute("purchase-orders.show", updated.ID)
}

// Destroy removes the record.
func (c *PurchaseOrderController) Destroy(ctx *fhttp.Context) error {
	who, _ := ctx.User()
	if err := c.svc.Delete(ctx.Ctx(), who, ctx.Param("id")); err != nil {
		return err
	}
	return ctx.RedirectRoute("purchase-orders.index")
}

// page is the chrome a screen hands the layout: the title, what a rejected
// attempt left in the flash -- the messages and what was typed -- and the CSRF
// token for this session.
//
// Every page needs the token, including the ones that write nothing: the
// sign-out form and every hx- request read it off the page data. A page
// rendered without one answers 200 and then refuses the next write with 419,
// which reads like a broken session rather than a missing field.
func (c *PurchaseOrderController) page(ctx *fhttp.Context, title string) (view.Page, error) {
	token, err := c.csrf.Issue(c.sessions.IDFromRequest(ctx.Request))
	return view.New(ctx, title).WithToken(token), err
}

// row turns the entity into what the markup renders: the text a cell shows and
// an input of the edit form starts at.
//
// Formatting happens here rather than in the view: a view that formats a
// time.Time would need the time package, and what a date looks like on screen is
// a decision about presentation, which is this side of the line.
//
// The address is settled here too, for the same reason and one more: the view
// has no route table, so a link written there could only be a literal. This
// takes the context so it can ask for the route by name.
func (c *PurchaseOrderController) row(ctx *fhttp.Context, p *models.PurchaseOrder) views.PurchaseOrderRow {
	return views.PurchaseOrderRow{
		ID:            p.ID,
		URL:           ctx.URL("purchase-orders.show", p.ID),
		Reference:     p.Reference,
		SupplierEmail: p.SupplierEmail,
		Total:         strconv.FormatInt(p.Total, 10),
		Approved:      p.Approved,
		Notes:         p.Notes,
		DeliveryDate:  p.DeliveryDate.Format("2006-01-02"),
		Created:       p.CreatedAt.Format("2006-01-02 15:04"),
	}
}

// arandu:begin custom
// Actions beyond the seven go here, and survive regeneration. Register them in
// the custom block of routes/web.go.
// arandu:end custom
