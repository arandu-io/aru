package billing

// Violation: Alpine reaching the server. This should be an HTMX fragment --
// x-data holds client state, and the moment it fetches, the application has two
// ways to load data with two loading states and two places to forget CSRF.
templ InvoiceList() {
	<div x-data="{ open: false, invoices: [], async load() { const r = await fetch('/api/invoices'); this.invoices = await r.json() } }">
		<button @click="open = !open">Toggle</button>
	</div>
}

// This one is fine: open/closed is client-only, ephemeral and invisible to the
// server, which is exactly what doc 14 permits.
templ Dropdown() {
	<div x-data="{ open: false }">
		<button @click="open = !open">Menu</button>
	</div>
}
