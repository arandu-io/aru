package requests

import (
	"time"

	"github.com/arandu-io/hesape/validation"
)

// StoreInvoice is an input contract: what the request is allowed to carry, and
// what makes it valid.
//
// The fields are explicit, and ctx.Bind fills each one through its form tag and
// nothing else. There is no mass assignment, so a field the client sends and
// this struct does not declare goes nowhere -- and a rule nobody wrote is not a
// rule somebody switched off.
//
// A request object often answers authorize() as well. This one does not, and
// that is the decision rather than an omission: authorization is the Policy, asked with
// auth.Authorize inside the service, and a second place to say yes is a
// second place to forget. See app/Policies.
type StoreInvoice struct {
	Reference     string     `form:"reference"`
	SupplierEmail string     `form:"supplier_email"`
	Total         int64      `form:"total"`
	DeliveryDate  *time.Time `form:"delivery_date"`
}

// Rules declares what each field may be, by the name of its form input. ctx.Bind
// runs them over the raw input before it converts anything, and a request that
// fails never reaches the service. The rules are the ones of the validation
// package, written as a pipe string or as a list.
func (StoreInvoice) Rules() validation.Rules {
	return validation.Rules{
		"reference":      "required|string|max:255",
		"supplier_email": "required|email|max:254",
		"total":          "required|integer",
		"delivery_date":  "nullable|date",
	}
}

// arandu:begin custom
// What the fields may be together, or against the data, is a Validate method of
// this request, and the service calls it before it authorizes:
//
//	func (r StoreInvoice) Validate() validation.Errors { ... }
// arandu:end custom
