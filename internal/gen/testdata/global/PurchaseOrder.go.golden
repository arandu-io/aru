package models

import (
	"log/slog"
	"time"

	"github.com/arandu-io/framework/data"
	"github.com/arandu-io/hesape/database/model"
)

// PurchaseOrder is one row of purchase_orders.
//
// It embeds the model, so a row returned by a query carries the connection and
// can be saved again. Build new rows through PurchaseOrders: a struct literal has
// no connection and its write methods return model.ErrUnwired.
type PurchaseOrder struct {
	model.Model[PurchaseOrder]

	ID            string    `db:"id"`
	Reference     string    `db:"reference"`
	SupplierEmail string    `db:"supplier_email"`
	Total         int64     `db:"total"`
	Approved      bool      `db:"approved"`
	Notes         string    `db:"notes"`
	DeliveryDate  time.Time `db:"delivery_date"`
	CreatedAt     time.Time `db:"created_at"`
	UpdatedAt     time.Time `db:"updated_at"`
}

// PurchaseOrders returns the configured model for purchase_orders.
//
// UseUniqueIDs makes the primary key text the model fills on insert.
// The tenant scope is disabled explicitly because this table is global.
func PurchaseOrders(db *data.DB) *model.Model[PurchaseOrder] {
	m := model.NewModel[PurchaseOrder]("purchase_orders", db, db.GetQueryGrammar(), db.GetPostProcessor()).UseUniqueIDs()
	m.TenantColumn = ""
	return m
}

// LogValue implements slog.LogValuer, so passing the whole entity to a log call
// records the identifiers and nothing else. Add any sensitive field to the
// custom block below and it stays out of logs, dumps and the debug page.
func (p PurchaseOrder) LogValue() slog.Value {
	return slog.GroupValue(
		slog.String("id", p.ID),
	)
}

// arandu:begin custom
// MarshalJSON, computed fields and anything else about this entity go here.
// arandu:end custom
