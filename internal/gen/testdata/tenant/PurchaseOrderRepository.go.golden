package repositories

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"strings"
	"time"

	"github.com/arandu-io/framework/data"
	"github.com/arandu-io/framework/security"

	models "example.test/project/app/Models"
	policies "example.test/project/app/Policies"
)

// Pagination bounds for purchase_orders. A request that asks for everything gets the
// maximum, never everything: an unbounded query is how one page load takes a
// database down.
const (
	purchaseOrderDefaultLimit = 50
	purchaseOrderMaxLimit     = 200
)

// PurchaseOrderRepository is the only door to the purchase_orders table.
//
// Every method starts with g.Check. The Grant is required by the signature, so
// forgetting it is a compile error, and the check proves the grant was issued for
// this exact action -- which catches copy-paste between methods.
//
// The SQL uses "?" placeholders and types every supported database shares, so
// these statements run unchanged on SQLite and PostgreSQL.
type PurchaseOrderRepository struct {
	db *data.DB
}

// NewPurchaseOrderRepository returns a repository over an instrumented handle.
func NewPurchaseOrderRepository(db *data.DB) *PurchaseOrderRepository {
	return &PurchaseOrderRepository{db: db}
}

// Compile-time proof of the contract.
var _ data.Repository[models.PurchaseOrder, string] = (*PurchaseOrderRepository)(nil)

const purchaseOrderColumns = `id, tenant_id, reference, supplier_email, total, approved, notes, delivery_date, created_at, updated_at`

// Find returns one purchase_order by id, scoped to the grant's tenant.
func (r *PurchaseOrderRepository) Find(ctx context.Context, g security.Grant, id string) (models.PurchaseOrder, error) {
	if err := g.Check(policies.PurchaseOrderView); err != nil {
		return models.PurchaseOrder{}, err
	}
	// The tenant comes from the Grant, never from the request.
	row := r.db.QueryRowContext(ctx,
		`SELECT `+purchaseOrderColumns+` FROM purchase_orders WHERE id = ? AND tenant_id = ?`,
		id, data.Tenant(g))
	return r.scan(row)
}

// purchaseOrderSortable is the ordering allowlist. A sort field is a column name, and a
// column name taken from the request is injection through a door nobody watches.
var purchaseOrderSortable = map[string]string{
	"":               "created_at",
	"created_at":     "created_at",
	"reference":      "reference",
	"supplier_email": "supplier_email",
	"notes":          "notes",
	"delivery_date":  "delivery_date",
}

// List returns a page of purchase_orders in the grant's tenant.
//
// Pagination is keyset based: OFFSET grows more expensive with every page and
// skips rows when data changes underneath it.
func (r *PurchaseOrderRepository) List(ctx context.Context, g security.Grant, q data.Query) ([]models.PurchaseOrder, error) {
	// PurchaseOrderList, not PurchaseOrderView. The specification can grant them to
	// different roles -- "a support agent may open the record it was given, but
	// may not page through every record there is" -- and checking view here made
	// the list permission decorative: whoever could read one could read all of them.
	if err := g.Check(policies.PurchaseOrderList); err != nil {
		return nil, err
	}
	column, ok := purchaseOrderSortable[q.Sort]
	if !ok {
		return nil, fmt.Errorf("%w: %q", models.ErrPurchaseOrderSort, q.Sort)
	}

	limit := q.Limit
	switch {
	case limit <= 0:
		limit = purchaseOrderDefaultLimit
	case limit > purchaseOrderMaxLimit:
		limit = purchaseOrderMaxLimit
	}

	query := `SELECT ` + purchaseOrderColumns + ` FROM purchase_orders WHERE tenant_id = ?`
	args := []any{data.Tenant(g)}
	if q.Cursor != "" {
		// The predicate names the column the ORDER BY names. It used to be
		// hardcoded to created_at while the ordering followed q.Sort, so any
		// sort other than the default computed the page boundary on one
		// ordering and returned the rows in another -- pages that skipped rows
		// and pages that repeated them, silently. The column comes from the
		// allowlist above, never from the request.
		query += ` AND (` + column + ` > (SELECT ` + column + ` FROM purchase_orders WHERE id = ? AND tenant_id = ?)
		            OR (` + column + ` = (SELECT ` + column + ` FROM purchase_orders WHERE id = ? AND tenant_id = ?) AND id > ?))`
		args = append(args, q.Cursor, args[0], q.Cursor, args[0], q.Cursor)
	}
	query += ` ORDER BY ` + column + `, id LIMIT ?`
	args = append(args, limit)

	rows, err := r.db.QueryContext(ctx, query, args...)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	var out []models.PurchaseOrder
	for rows.Next() {
		p, err := r.scan(rows)
		if err != nil {
			return nil, err
		}
		out = append(out, p)
	}
	return out, rows.Err()
}

// Create inserts the purchase_order and returns it as stored.
func (r *PurchaseOrderRepository) Create(ctx context.Context, g security.Grant, p models.PurchaseOrder) (models.PurchaseOrder, error) {
	if err := g.Check(policies.PurchaseOrderCreate); err != nil {
		return models.PurchaseOrder{}, err
	}

	var err error
	if p.ID == "" {
		// The id comes from the application, not from a database default:
		// gen_random_uuid, UUID() and randomblob are three spellings of one idea,
		// and depending on any of them would tie the schema to one engine.
		if p.ID, err = data.NewID(); err != nil {
			return models.PurchaseOrder{}, err
		}
	}
	p.TenantID = data.Tenant(g)
	p.SupplierEmail = r.normalize(p.SupplierEmail)
	// Both stamps are the repository's, and they are the same instant on insert:
	// a row that was never updated has updated_at equal to created_at, which is
	// what "not updated since it was written" reads as.
	p.CreatedAt = time.Now().UTC()
	p.UpdatedAt = p.CreatedAt

	_, err = r.db.ExecContext(ctx,
		`INSERT INTO purchase_orders (`+purchaseOrderColumns+`) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
		p.ID, p.TenantID, p.Reference, p.SupplierEmail, p.Total, p.Approved, p.Notes, data.Day(p.DeliveryDate), p.CreatedAt, p.UpdatedAt)
	if err != nil {
		if r.conflict(err) {
			return models.PurchaseOrder{}, models.ErrPurchaseOrderConflict
		}
		return models.PurchaseOrder{}, err
	}
	return p, nil
}

// Update writes the mutable fields. The tenant is not one of them:
// moving a row between tenants is not an update, it is a migration.
func (r *PurchaseOrderRepository) Update(ctx context.Context, g security.Grant, p models.PurchaseOrder) (models.PurchaseOrder, error) {
	if err := g.Check(policies.PurchaseOrderUpdate); err != nil {
		return models.PurchaseOrder{}, err
	}
	p.SupplierEmail = r.normalize(p.SupplierEmail)

	// The stamp is the repository's here, not the caller's: an update that left
	// updated_at alone would make the column a lie, and the caller has no reason
	// to remember a column the schema owns.
	p.UpdatedAt = time.Now().UTC()

	res, err := r.db.ExecContext(ctx,
		`UPDATE purchase_orders SET reference = ?, supplier_email = ?, total = ?, approved = ?, notes = ?, delivery_date = ?, updated_at = ? WHERE id = ? AND tenant_id = ?`,
		p.Reference, p.SupplierEmail, p.Total, p.Approved, p.Notes, data.Day(p.DeliveryDate), p.UpdatedAt, p.ID, data.Tenant(g))
	if err != nil {
		if r.conflict(err) {
			return models.PurchaseOrder{}, models.ErrPurchaseOrderConflict
		}
		return models.PurchaseOrder{}, err
	}
	if n, err := res.RowsAffected(); err == nil && n == 0 {
		return models.PurchaseOrder{}, models.ErrPurchaseOrderNotFound
	}
	return p, nil
}

// Delete removes one purchase_order within the grant's tenant.
func (r *PurchaseOrderRepository) Delete(ctx context.Context, g security.Grant, id string) error {
	if err := g.Check(policies.PurchaseOrderDelete); err != nil {
		return err
	}
	res, err := r.db.ExecContext(ctx,
		`DELETE FROM purchase_orders WHERE id = ? AND tenant_id = ?`, id, data.Tenant(g))
	if err != nil {
		return err
	}
	if n, err := res.RowsAffected(); err == nil && n == 0 {
		return models.ErrPurchaseOrderNotFound
	}
	return nil
}

// Health reports whether the repository can reach its storage.
//
// Nothing calls it out of the box. It is here so AppServiceProvider can
// implement kernel.Health over the repositories it owns, which is what puts this
// table on /_arandu/health and on the error page's diagnosis.
func (r *PurchaseOrderRepository) Health(ctx context.Context) error { return r.db.PingContext(ctx) }

// scan reads one row.
//
// It takes the interface inline rather than a named one, and it is a method
// rather than a function, for the same reason as the helpers below: every
// repository of the application shares this package, and a second module
// declaring rowScanner would not compile.
func (r *PurchaseOrderRepository) scan(row interface{ Scan(dest ...any) error }) (models.PurchaseOrder, error) {
	var p models.PurchaseOrder
	err := row.Scan(&p.ID, &p.TenantID, &p.Reference, &p.SupplierEmail, &p.Total, &p.Approved, &p.Notes, &p.DeliveryDate, &p.CreatedAt, &p.UpdatedAt)
	if errors.Is(err, sql.ErrNoRows) {
		return models.PurchaseOrder{}, models.ErrPurchaseOrderNotFound
	}
	if err != nil {
		return models.PurchaseOrder{}, err
	}
	return p, nil
}

// normalize lowercases and trims, which is what keeps a plain UNIQUE index
// case-insensitive on every engine.
func (r *PurchaseOrderRepository) normalize(s string) string {
	return strings.ToLower(strings.TrimSpace(s))
}

// conflict recognizes a duplicate key across engines by message, which is the
// price of not importing a driver into a repository.
func (r *PurchaseOrderRepository) conflict(err error) bool {
	if err == nil {
		return false
	}
	msg := strings.ToLower(err.Error())
	return strings.Contains(msg, "unique constraint") ||
		strings.Contains(msg, "duplicate key") ||
		strings.Contains(msg, "duplicate entry")
}

// arandu:begin custom
// Queries beyond the five above go here, and survive regeneration. Keep the
// g.Check as the first line of each one.
// arandu:end custom
