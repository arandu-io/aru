# The configuration the generator's skeleton ships: SQLite in a file, and every
# store in the process. The only engine it names is linked, by the blank import
# in main.go.

# --- config/database.go ----------------------------------------------------
#   DATABASE_URL=postgres://user:password@127.0.0.1:5432/dbname
DATABASE_URL=sqlite://database/database.sqlite

# --- config/session.go -----------------------------------------------------
SESSION_DRIVER=memory

# --- config/cache.go -------------------------------------------------------
CACHE_STORE=memory

# --- config/queue.go -------------------------------------------------------
QUEUE_CONNECTION=database
