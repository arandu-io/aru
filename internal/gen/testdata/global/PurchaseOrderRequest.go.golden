package requests

import (
	"time"

	"github.com/arandu-io/framework/validation"
)

// StorePurchaseOrder is the input contract of creation. Fields are explicit: there
// is no mass assignment, so a field the client sends and this struct does not
// declare goes nowhere.
type StorePurchaseOrder struct {
	Reference     string
	SupplierEmail string
	Total         int64
	Approved      bool
	Notes         string
	DeliveryDate  time.Time
}

// Validate reports the errors per field.
func (r StorePurchaseOrder) Validate() validation.Errors {
	e := validation.Errors{}
	validation.Required(e, "reference", r.Reference)
	validation.MaxLen(e, "reference", r.Reference, 255)
	validation.Required(e, "supplier_email", r.SupplierEmail)
	validation.Email(e, "supplier_email", r.SupplierEmail)
	validation.MaxLen(e, "supplier_email", r.SupplierEmail, 254)
	validation.NotZero(e, "total", r.Total)
	validation.MaxLen(e, "notes", r.Notes, 5000)

	// arandu:begin custom
	// Domain rules go here: ranges, formats, cross-field checks.
	// arandu:end custom

	return e
}

// UpdatePurchaseOrder carries the id as well, and the same rules.
type UpdatePurchaseOrder struct {
	ID            string
	Reference     string
	SupplierEmail string
	Total         int64
	Approved      bool
	Notes         string
	DeliveryDate  time.Time
}

// Validate reports the errors per field.
func (r UpdatePurchaseOrder) Validate() validation.Errors {
	e := StorePurchaseOrder{
		Reference:     r.Reference,
		SupplierEmail: r.SupplierEmail,
		Total:         r.Total,
		Approved:      r.Approved,
		Notes:         r.Notes,
		DeliveryDate:  r.DeliveryDate,
	}.Validate()
	validation.Required(e, "id", r.ID)
	return e
}

// Compile-time proof that both requests honor the validation contract.
var (
	_ validation.Validatable = StorePurchaseOrder{}
	_ validation.Validatable = UpdatePurchaseOrder{}
)

var _ = time.Time{}
