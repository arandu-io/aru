{
  "comments": { "blockComment": ["{{--", "--}}"] },
  "brackets": [["{{", "}}"], ["{!!", "!!}"], ["<", ">"]],
  "autoClosingPairs": [
    { "open": "{{", "close": " }}" },
    { "open": "{!!", "close": " !!}" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [["{{", "}}"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*@(section|if|foreach|for|while|go)\\b",
    "decreaseIndentPattern": "^\\s*@(endsection|endif|endforeach|endfor|endwhile|endgo|else|elseif)\\b"
  }
}
