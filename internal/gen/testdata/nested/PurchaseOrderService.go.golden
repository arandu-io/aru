package services

import (
	"context"
	"fmt"
	"strings"

	"github.com/arandu-io/hesape/auth"
	"github.com/arandu-io/hesape/database"
	"github.com/arandu-io/hesape/log"
	"github.com/arandu-io/hesape/pagination"

	requests "example.test/project/app/Http/Requests"
	models "example.test/project/app/Models"
	policies "example.test/project/app/Policies"
)

// purchaseOrderListing declares, once, what the listing of purchase orders may search,
// order by, page by and hide. A listing is always a page, never everything: an
// unbounded query is how one page load takes a database down.
//
// Nothing the request carries names a column. The controller reads the request
// through this value, and it drops whatever it does not declare -- a sort that
// is not a key below, a page size that is not offered, a direction that is
// neither asc nor desc -- so a hostile query string falls back to the default
// instead of reaching the query. Every column below is written here, in code.
//
// The Search columns hold text. A facet -- a filter over a column with a short
// list of values, such as a status -- is one more entry of Facets, with the
// values listed in the spec:
//
//	Facets: []pagination.FacetSpec{{Key: "status", Column: "status", Values: []string{"open", "done"}}},
//
// and a DataTableFilter of the same Key in the index view draws it.
var purchaseOrderListing = func() *pagination.Listing {
	listing, err := pagination.NewListing(pagination.ListingSpec{
		Search: []string{
			"reference",
			"supplier_email",
			"notes",
		},
		Sorts: map[string]string{
			"reference":      "reference",
			"supplier_email": "supplier_email",
			"total":          "total",
			"approved":       "approved",
			"notes":          "notes",
			"delivery_date":  "delivery_date",
			"created_at":     "created_at",
		},
		DefaultSort:     "created_at",
		DefaultDir:      pagination.SortDesc,
		TieBreak:        "id",
		PageSizes:       []int{10, 25, 50},
		DefaultPageSize: 25,
		Hideable: []string{
			"supplier_email",
			"total",
			"approved",
			"notes",
			"delivery_date",
			"created_at",
		},
	})
	if err != nil {
		// A spec the package refuses is a mistake in this file, and it is found
		// when the program starts and not on the first request.
		panic(fmt.Sprintf("services: the purchase orders listing: %v", err))
	}
	return listing
}()

// PurchaseOrderService holds the business rules. It receives its dependencies through
// the constructor -- explicit wiring, no container.
//
// Every method authorizes before it reaches the Model, and the errors it returns
// are the ones the router answers: validation.Errors back to the form, a missing
// row as 404, a refusal as 403 and a duplicate on a unique column as 409.
type PurchaseOrderService struct {
	db     *database.DB
	policy policies.PurchaseOrderPolicy
	// parents loads the supplier a purchase order belongs to, under the
	// supplier's own policy: the parent in a path is where the person
	// navigated, never whose data it is.
	parents *SupplierService
}

// NewPurchaseOrderService wires the service.
func NewPurchaseOrderService(db *database.DB, parents *SupplierService) *PurchaseOrderService {
	return &PurchaseOrderService{db: db, parents: parents}
}

// Create walks the mandatory path: validate, Authorize, Grant, Model.
// There is no other order that compiles.
func (s *PurchaseOrderService) Create(ctx context.Context, actor auth.Subject, supplierID string, in requests.PurchaseOrderRequest) (*models.PurchaseOrder, error) {
	if errs := in.Validate(); errs.Any() {
		return nil, errs
	}

	// The supplier is loaded through its own service, so one this
	// subject may not see is a refusal here and never a row under it.
	parent, err := s.parents.Get(ctx, actor, supplierID)
	if err != nil {
		return nil, err
	}

	var proposed models.PurchaseOrder
	s.fill(&proposed, in)
	proposed.SupplierID = parent.ID
	g, err := auth.Authorize(ctx, s.policy, actor, policies.PurchaseOrderCreate, proposed)
	if err != nil {
		return nil, err
	}

	record, err := models.PurchaseOrders(s.db).New()
	if err != nil {
		return nil, err
	}
	s.fill(record, in)
	record.SupplierID = parent.ID
	// The tenant comes from the Grant, never from the request or the subject
	// directly. The model writes the same value over the insert attributes.
	record.TenantID = auth.Tenant(g)
	if _, err := record.Save(ctx, g); err != nil {
		return nil, err
	}
	// Guarded: the entity is a struct value, and boxing it into `any` allocates
	// at the call site even though RecordEvent is a no-op on a nil Collector.
	if col := log.FromContext(ctx); col != nil {
		col.RecordEvent("purchase_order.created", record)
	}
	return record, nil
}

// Get returns one purchase_order.
//
// It authorizes twice: once to look at all, and once with the row that was
// read, which is the decision about this row rather than about the action.
func (s *PurchaseOrderService) Get(ctx context.Context, actor auth.Subject, id string) (*models.PurchaseOrder, error) {
	g, err := auth.Authorize(ctx, s.policy, actor, policies.PurchaseOrderView, models.PurchaseOrder{})
	if err != nil {
		return nil, err
	}
	found, err := models.PurchaseOrders(s.db).FindOrFail(ctx, g, id)
	if err != nil {
		return nil, err
	}
	if _, err := auth.Authorize(ctx, s.policy, actor, policies.PurchaseOrderView, *found); err != nil {
		return nil, err
	}
	return found, nil
}

// Editable returns one purchase_order for the edit form, which is shown only to
// somebody who may change it. It reads the row as Get does and then asks the
// update action about the row that was read: a form that opened for anybody
// who may look would let them type into a save they are refused.
func (s *PurchaseOrderService) Editable(ctx context.Context, actor auth.Subject, id string) (*models.PurchaseOrder, error) {
	found, err := s.Get(ctx, actor, id)
	if err != nil {
		return nil, err
	}
	if _, err := auth.Authorize(ctx, s.policy, actor, policies.PurchaseOrderUpdate, *found); err != nil {
		return nil, err
	}
	return found, nil
}

// Listing is what the listing of purchase orders accepts. The controller reads the
// request through it and hands the state it returns to List.
func (s *PurchaseOrderService) Listing() *pagination.Listing { return purchaseOrderListing }

// List returns one page of the purchase_orders of one supplier as the listing
// state asks -- the search, the order, the page and its size -- and the result
// a table is drawn from, newest first unless the state orders otherwise. path
// is the address the listing is served at, which its links are built on. The
// supplier is loaded under its own policy first, and the page is
// filtered by the one that was loaded -- not by the id the path carried.
func (s *PurchaseOrderService) List(ctx context.Context, actor auth.Subject, supplierID string, state pagination.ListingState, path string) (models.PurchaseOrderCollection, *pagination.ListingResult, error) {
	parent, err := s.parents.Get(ctx, actor, supplierID)
	if err != nil {
		return nil, nil, err
	}
	g, err := auth.Authorize(ctx, s.policy, actor, policies.PurchaseOrderList, models.PurchaseOrder{SupplierID: parent.ID})
	if err != nil {
		return nil, nil, err
	}
	return models.PurchaseOrders(s.db).Where("supplier_id", parent.ID).Listing(ctx, g, state, path)
}

// Update changes the mutable fields.
//
// It reads before writing, so the policy decides against the stored row rather
// than against what the client claims the row is. Skipping this is how a check
// passes on attacker-supplied data.
func (s *PurchaseOrderService) Update(ctx context.Context, actor auth.Subject, id string, in requests.PurchaseOrderRequest) (*models.PurchaseOrder, error) {
	if errs := in.Validate(); errs.Any() {
		return nil, errs
	}

	stored, err := s.Get(ctx, actor, id)
	if err != nil {
		return nil, err
	}

	g, err := auth.Authorize(ctx, s.policy, actor, policies.PurchaseOrderUpdate, *stored)
	if err != nil {
		return nil, err
	}
	s.fill(stored, in)
	if _, err := stored.Save(ctx, g); err != nil {
		return nil, err
	}
	return stored, nil
}

// Delete removes a purchase_order.
func (s *PurchaseOrderService) Delete(ctx context.Context, actor auth.Subject, id string) error {
	stored, err := s.Get(ctx, actor, id)
	if err != nil {
		return err
	}

	g, err := auth.Authorize(ctx, s.policy, actor, policies.PurchaseOrderDelete, *stored)
	if err != nil {
		return err
	}
	if _, err := stored.Delete(ctx, g); err != nil {
		return err
	}
	if col := log.FromContext(ctx); col != nil {
		col.RecordEvent("purchase_order.deleted", stored)
	}
	return nil
}

// fill writes the request onto the record. It is the one place a field of the
// form becomes a column, for Create and Update alike.
func (s *PurchaseOrderService) fill(p *models.PurchaseOrder, in requests.PurchaseOrderRequest) {
	p.Reference = in.Reference
	p.SupplierEmail = strings.ToLower(in.SupplierEmail)
	p.Total = in.Total
	p.Approved = in.Approved
	p.Notes = in.Notes
	p.DeliveryDate = in.DeliveryDate
	if in.DeliveryDate != nil {
		day := database.Day(*in.DeliveryDate)
		p.DeliveryDate = &day
	}
}

