//go:build kyse

package views

@go
// PurchaseOrdersIndexData is what PurchaseOrderController.Index hands this page.
type PurchaseOrdersIndexData struct {
	// Page is the state the layout draws: the title, the brand, the CSRF token
	// and the navigation. Embedded rather than repeated, and what makes this
	// struct fit the layout.
	Page
	// PurchaseOrders is the page of records.
	PurchaseOrders []PurchaseOrderRow
	// NextCursor is the keyset cursor of the following page. It is empty on the
	// last page, and the link is not rendered then.
	NextCursor string
}

// Compile-time proof that this page fits the layout it extends.
var _ Layout = PurchaseOrdersIndexData{}

// PurchaseOrderRow is one record, formatted for display by the controller.
type PurchaseOrderRow struct {
	// ID is what the row links to.
	ID string
	// Reference is the Reference column.
	Reference string
	// SupplierEmail is the Supplier email column.
	SupplierEmail string
	// Total is the Total column.
	Total int64
	// Approved is the Approved column.
	Approved bool
	// Notes is the Notes column.
	Notes string
	// DeliveryDate is the Delivery date column.
	DeliveryDate string
	// Created is the creation timestamp, already formatted.
	Created string
}

// arandu:begin custom
// Anything else these pages need in Go goes here, and survives regeneration.
// arandu:end custom
@endgo

@extends('layouts.app')

@section('content')
	<div class="flex items-center justify-between gap-4">
		<h1 class="text-3xl font-semibold tracking-tight">{{ .Title }}</h1>
		<a class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900" href="/purchase-orders/create">New purchase order</a>
	</div>

	@if(len(d.PurchaseOrders) == 0)
	<p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
		No purchase order yet. <a class="underline underline-offset-2" href="/purchase-orders/create">Add the first one</a>.
	</p>
	@endif

	@if(len(d.PurchaseOrders) > 0)
	<div class="mt-8 overflow-x-auto">
		<table class="w-full border-collapse text-left text-sm">
			<thead class="border-b border-slate-200 text-slate-500 dark:border-slate-800 dark:text-slate-400">
				<tr>
					<th class="py-2 pr-4 font-medium">Reference</th>
					<th class="py-2 pr-4 font-medium">Supplier email</th>
					<th class="py-2 pr-4 font-medium">Total</th>
					<th class="py-2 pr-4 font-medium">Approved</th>
					<th class="py-2 pr-4 font-medium">Notes</th>
					<th class="py-2 pr-4 font-medium">Delivery date</th>
					<th class="py-2 font-medium">Created</th>
				</tr>
			</thead>
			<tbody>
				@foreach(.PurchaseOrders as purchaseOrder)
				<tr class="border-b border-slate-100 dark:border-slate-900">
					<td class="py-2 pr-4">
						<a class="font-medium underline underline-offset-2" href="/purchase-orders/{{ purchaseOrder.ID }}">{{ purchaseOrder.Reference }}</a>
					</td>
					<td class="py-2 pr-4">{{ purchaseOrder.SupplierEmail }}</td>
					<td class="py-2 pr-4">{{ purchaseOrder.Total }}</td>
					<td class="py-2 pr-4">{{ purchaseOrder.Approved }}</td>
					<td class="py-2 pr-4">{{ purchaseOrder.Notes }}</td>
					<td class="py-2 pr-4">{{ purchaseOrder.DeliveryDate }}</td>
					<td class="py-2 text-slate-500 dark:text-slate-400">{{ purchaseOrder.Created }}</td>
				</tr>
				@endforeach
			</tbody>
		</table>
	</div>
	@endif

	@if(d.NextCursor != "")
	<a class="mt-6 inline-block text-sm underline underline-offset-2" href="/purchase-orders?cursor={{ .NextCursor }}">Next page</a>
	@endif
@endsection
