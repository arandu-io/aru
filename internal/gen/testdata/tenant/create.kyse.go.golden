			<input class="block w-full rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" id="total" name="total" type="number" step="1" value="{{ .Form.Total }}" required>
			@if(len(d.Errors["total"]) > 0)
			<p class="text-sm text-red-600 dark:text-red-400">{{ d.Errors["total"][0] }}</p>
