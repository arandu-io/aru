package services

import (
	"context"
	"strings"

	"github.com/arandu-io/framework/data"
	"github.com/arandu-io/framework/observability"
	"github.com/arandu-io/framework/security"
	"github.com/arandu-io/hesape/pagination"

	requests "example.test/project/app/Http/Requests"
	models "example.test/project/app/Models"
	policies "example.test/project/app/Policies"
)

// purchaseOrderPerPage is how many purchase_orders one page of the listing holds. A
// listing is always a page, never everything: an unbounded query is how one
// page load takes a database down.
const purchaseOrderPerPage = 25

// PurchaseOrderService holds the business rules. It receives its dependencies through
// the constructor -- explicit wiring, no container.
//
// Every method authorizes before it reaches the Model, and the errors it returns
// are the ones the router answers: validation.Errors back to the form, a missing
// row as 404, a refusal as 403 and a duplicate on a unique column as 409.
type PurchaseOrderService struct {
	db     *data.DB
	policy policies.PurchaseOrderPolicy
}

// NewPurchaseOrderService wires the service.
func NewPurchaseOrderService(db *data.DB) *PurchaseOrderService {
	return &PurchaseOrderService{db: db}
}

// Create walks the mandatory path: validate, Authorize, Grant, Model.
// There is no other order that compiles.
func (s *PurchaseOrderService) Create(ctx context.Context, actor security.Subject, in requests.PurchaseOrderRequest) (*models.PurchaseOrder, error) {
	if errs := in.Validate(); errs.Any() {
		return nil, errs
	}

	var proposed models.PurchaseOrder
	s.fill(&proposed, in)
	g, err := security.Authorize(ctx, s.policy, actor, policies.PurchaseOrderCreate, proposed)
	if err != nil {
		return nil, err
	}

	instance, err := models.PurchaseOrders(s.db).NewInstance(nil, false)
	if err != nil {
		return nil, err
	}
	record := instance.Entity
	s.fill(record, in)
	if _, err := record.Save(ctx, g); err != nil {
		return nil, err
	}
	// Guarded: the entity is a struct value, and boxing it into `any` allocates
	// at the call site even though RecordEvent is a no-op on a nil Collector.
	if col := observability.FromContext(ctx); col != nil {
		col.RecordEvent("purchase_order.created", record)
	}
	return record, nil
}

// Get returns one purchase_order.
//
// It authorizes twice: once to look at all, and once with the row that was
// read, which is the decision about this row rather than about the action.
func (s *PurchaseOrderService) Get(ctx context.Context, actor security.Subject, id string) (*models.PurchaseOrder, error) {
	g, err := security.Authorize(ctx, s.policy, actor, policies.PurchaseOrderView, models.PurchaseOrder{})
	if err != nil {
		return nil, err
	}
	found, err := models.PurchaseOrders(s.db).FindOrFail(ctx, g, id)
	if err != nil {
		return nil, err
	}
	if _, err := security.Authorize(ctx, s.policy, actor, policies.PurchaseOrderView, *found); err != nil {
		return nil, err
	}
	return found, nil
}

// List returns one page of purchase_orders, newest first.
func (s *PurchaseOrderService) List(ctx context.Context, actor security.Subject, page int) (*pagination.Paginator[*models.PurchaseOrder], error) {
	g, err := security.Authorize(ctx, s.policy, actor, policies.PurchaseOrderList, models.PurchaseOrder{})
	if err != nil {
		return nil, err
	}
	return models.PurchaseOrders(s.db).Latest().OrderBy("id").
		SimplePaginate(ctx, g, purchaseOrderPerPage, page, pagination.Options{})
}

// Update changes the mutable fields.
//
// It reads before writing, so the policy decides against the stored row rather
// than against what the client claims the row is. Skipping this is how a check
// passes on attacker-supplied data.
func (s *PurchaseOrderService) Update(ctx context.Context, actor security.Subject, id string, in requests.PurchaseOrderRequest) (*models.PurchaseOrder, error) {
	if errs := in.Validate(); errs.Any() {
		return nil, errs
	}

	stored, err := s.Get(ctx, actor, id)
	if err != nil {
		return nil, err
	}

	g, err := security.Authorize(ctx, s.policy, actor, policies.PurchaseOrderUpdate, *stored)
	if err != nil {
		return nil, err
	}
	s.fill(stored, in)
	if _, err := stored.Save(ctx, g); err != nil {
		return nil, err
	}
	return stored, nil
}

// Delete removes a purchase_order.
func (s *PurchaseOrderService) Delete(ctx context.Context, actor security.Subject, id string) error {
	stored, err := s.Get(ctx, actor, id)
	if err != nil {
		return err
	}

	g, err := security.Authorize(ctx, s.policy, actor, policies.PurchaseOrderDelete, *stored)
	if err != nil {
		return err
	}
	if _, err := stored.Delete(ctx, g); err != nil {
		return err
	}
	if col := observability.FromContext(ctx); col != nil {
		col.RecordEvent("purchase_order.deleted", stored)
	}
	return nil
}

// fill writes the request onto the record. It is the one place a field of the
// form becomes a column, for Create and Update alike.
func (s *PurchaseOrderService) fill(p *models.PurchaseOrder, in requests.PurchaseOrderRequest) {
	p.Reference = in.Reference
	p.SupplierEmail = strings.ToLower(in.SupplierEmail)
	p.Total = in.Total
	p.Approved = in.Approved
	p.Notes = in.Notes
	p.DeliveryDate = data.Day(in.DeliveryDate)
}

// arandu:begin custom
// Business rules beyond CRUD go here, and survive regeneration.
// arandu:end custom
