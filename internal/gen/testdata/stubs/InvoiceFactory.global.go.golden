package factories

import (
	"time"

	"github.com/arandu-io/framework/data"
	factory "github.com/arandu-io/hesape/database/model/factories"
	"github.com/arandu-io/hesape/faker"

	models "example.test/project/app/Models"
)

// InvoiceFactory returns the factory of invoices over db.
//
//	rows, err := factories.InvoiceFactory(db).Count(10).Create(ctx, g)
//	one, err := factories.InvoiceFactory(db).State(func(i *models.Invoice) { ... }).MakeOne()
//
// Make builds rows and stores nothing. Create stores them, and takes the Grant
// every write takes: a factory is no way around the
// policy that guards the table.
//
// The values come from a seeded faker -- the same rows on every run, so a
// failure reproduces -- and Seed asks for others. The key is left empty: the
// model draws a fresh one for every row it stores, so two batches never share
// one, and Make builds rows that have none yet.
func InvoiceFactory(db *data.DB) *factory.Factory[models.Invoice] {
	return factory.For(models.Invoices(db), func(f faker.Faker) models.Invoice {
		return models.Invoice{
			Reference:     f.UserName(),
			SupplierEmail: f.Email(),
			Total:         int64(f.Int(1, 1000)),
			DeliveryDate:  f.Time(time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC), time.Date(2027, 1, 1, 0, 0, 0, 0, time.UTC)),
		}
	})
}

// arandu:begin custom
// Named states go here, and survive regeneration: a factory with one thing
// said about it, built on the one above.
// arandu:end custom
